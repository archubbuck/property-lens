# PropertyLens environment variables.
# Copy to .env.local for local development. Never commit real secrets.
# See docs/operations/environment.md for full descriptions and where each
# value is sourced per environment (local / preview / production).

# --- Database -----------------------------------------------------------
# Local dev default matches docker-compose.yml. Preview/production must use
# isolated, least-privilege credentials provisioned per environment.
DATABASE_URL="postgresql://propertylens:propertylens_dev_only@localhost:5432/propertylens"

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Toggles the built-in development identity provider when Clerk keys are not
# configured. Must be "false" (or unset) in any deployed environment.
AUTH_DEV_MODE="true"

# --- Clerk (identity & billing) -------------------------------------------
# Required for real sign-in/sign-up, MFA, OAuth, webhooks, and billing in any
# deployed environment. See docs/operations/external-setup.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# --- Billing (adapter-selected provider) ----------------------------------
BILLING_WEBHOOK_SECRET=""

# --- Durable research workflow ---------------------------------------------
# Selected after documented evaluation (Inngest or Trigger.dev). Until
# configured, the in-process simulated orchestrator (server/infrastructure/jobs)
# is used for local development and tests only.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- AI inference -----------------------------------------------------------
AI_PROVIDER_API_KEY=""

# --- Object storage (evidence snapshots & attachments) ---------------------
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# --- Telemetry --------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
